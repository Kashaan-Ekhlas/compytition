# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=compytition
POSTGRES_PASSWORD=compytition
POSTGRES_DB=compytition
POSTGRES_PORT=5433

# ── Ports ───────────────────────────────────────────────────────────────────
# The web app intentionally avoids 3000 so it can run next to other projects.
WEB_PORT=3100
API_PORT=8080

# ── API ─────────────────────────────────────────────────────────────────────
APP_ENV=development
WEB_ORIGIN=http://localhost:3100
# Local development talks to the compose database on 5433. When running
# `go run ./cmd/api` directly, use this URL.
DATABASE_URL=postgres://compytition:compytition@localhost:5433/compytition?sslmode=disable
SESSION_TTL_HOURS=720
COOKIE_SECURE=false
AUTO_MIGRATE=true
LOG_LEVEL=info
RATE_LIMIT_PER_MIN=240

# ── Google sign-in (optional) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# ── Web ─────────────────────────────────────────────────────────────────────
# Internal API origin used by Next.js rewrites (container name in Compose).
API_INTERNAL_URL=http://localhost:8080
# Browser-facing websocket origin for team chat. Empty means same-origin.
NEXT_PUBLIC_WS_BASE=ws://localhost:8080

# ── Admin feedback queue ────────────────────────────────────────────────────
ADMIN_EMAILS=
